PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Required in production (NODE_ENV=production)
JWT_SECRET=
ENCRYPTION_KEY=

MONGODB_URI=mongodb://127.0.0.1:27017/ezymed
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to true only after legal/BAA review — enables OpenAI for AI patient summaries
OPENAI_PHI_ENABLED=false

# Email (optional in dev — logs to console; required in production for verification/reset)
EMAIL_FROM=noreply@ezymed.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Socket.IO CORS (comma-separated origins in production)
# CORS_ORIGIN=https://app.ezymed.com

# Logging
LOG_LEVEL=debug

# Staff seed passwords (change after first deploy)
DOCTOR_DEFAULT_PASSWORD=Doctor@123
HOSPITAL_ADMIN_EMAIL=admin@ezymed.com
HOSPITAL_ADMIN_PASSWORD=Admin@123
PHARMACY_DEFAULT_PASSWORD=Pharmacy@123
