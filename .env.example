PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ezymed
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# OpenAI — required for AI symptom checker
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Staff account seed (first startup only — credentials are stored hashed in MongoDB)
# Set strong values before first deploy, then change passwords directly in the database.
DOCTOR_DEFAULT_PASSWORD=Doctor@123
HOSPITAL_ADMIN_EMAIL=admin@ezymed.com
HOSPITAL_ADMIN_PASSWORD=Admin@123
